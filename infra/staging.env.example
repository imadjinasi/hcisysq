POSTGRES_DB=hcis_staging
POSTGRES_USER=hcis_staging_app
POSTGRES_PASSWORD=replace_with_a_long_random_staging_password

# Generate with: openssl rand -hex 32
AUTH_ENCRYPTION_KEY=replace_with_64_hex_characters
AUTH_SESSION_TTL_HOURS=8

# Pull prebuilt staging images on the shared VPS; do not build there.
HCIS_API_IMAGE=ghcr.io/imadjinasi/hcisysq-api:staging
HCIS_WEB_IMAGE=ghcr.io/imadjinasi/hcisysq-web:staging

# HUB-IMPL-003 accepted staging identity contract.
# Staging and production use the permanent SQ Identity hostname and separate realms.
OIDC_ISSUER=https://login.sabilulquran.or.id/realms/sq-staff-staging
OIDC_CLIENT_ID=hcis-staging
OIDC_CLIENT_SECRET=replace_with_hcis_staging_client_secret
OIDC_REDIRECT_URI=https://hcis-staging.sabilulquran.or.id/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://hcis-staging.sabilulquran.or.id/

# SQ Hub Application Access stays private on the shared staging Docker network.
SQ_HUB_APPLICATION_ACCESS_URL=http://sq-hub-api-staging:3100/internal/v1/application-access/check
SQ_HUB_MACHINE_CLIENT_ID=hcis-api-staging
SQ_HUB_MACHINE_CLIENT_SECRET=replace_with_hcis_api_staging_service_secret

# Pre-create these external networks on the shared staging VPS.
EDGE_NETWORK=edge_proxy
SQ_PLATFORM_STAGING_NETWORK=sq_platform_staging

HCIS_BIND_ADDRESS=127.0.0.1
HCIS_HTTP_PORT=18081

POSTGRES_MEMORY_LIMIT=320m
API_MEMORY_LIMIT=192m
WEB_MEMORY_LIMIT=96m
