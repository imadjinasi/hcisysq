# ATT-004 production machine-only ingress template.
# Apply only after human-approved DNS/deployment cutover.
# HTTP is intentional because HTTPS capability remains unverified for the physical pilot firmware.
http://adms.sabilulquran.or.id {
    @iclock path /iclock/*
    handle @iclock {
        request_body {
            max_size 512KB
        }
        reverse_proxy hcis-api:3001
    }

    respond 404
}
