# ATT-004 staging machine-only ingress.
# HTTP is intentional until the physically validated firmware is proven to support HTTPS.
# Do not route browser/admin traffic through this hostname.
http://adms-hcis-staging.sabilulquran.or.id {
    @iclock path /iclock/*
    handle @iclock {
        request_body {
            max_size 512KB
        }
        reverse_proxy hcis-staging-api:3001
    }

    respond 404
}
